# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI (Server-side optional integration)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=

# Binance Demo Trading Controls
BINANCE_MAX_ORDER_USD=1000
BINANCE_MAX_LEVERAGE=10
DISABLE_BINANCE_STREAM=false

# Development Flags
DISABLE_HMR=false

# Local Ollama AI Analyst (runs against local machine)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=300000

# Optional Telegram Notifications (Server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
